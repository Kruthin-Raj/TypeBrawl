{
  "name": "typefest-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @typefest/server dev\" \"pnpm --filter @typefest/web dev\"",
    "dev:web": "pnpm --filter @typefest/web dev",
    "dev:server": "pnpm --filter @typefest/server dev",
    "build": "pnpm --filter @typefest/shared build && pnpm --filter @typefest/server build && pnpm --filter @typefest/web build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}